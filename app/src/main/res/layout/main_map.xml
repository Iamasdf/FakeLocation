<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".MainActivity"
    tools:showIn="@layout/main_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.baidu.mapapi.map.MapView
            android:id="@+id/bdMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- 地图类型：普通 / 卫星 -->
        <RadioGroup
            android:id="@+id/RadioGroupMapType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_map_dock"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <RadioButton
                android:id="@+id/mapNormal"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:button="@null"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/map_pic_normal"
                android:textColor="@color/map_type_text"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/mapSatellite"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:button="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/map_pic_sate"
                android:textColor="@color/map_type_text"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- 右侧操作坞 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_map_dock"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/input_pos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/input_button"
                android:src="@drawable/ic_input"
                app:tint="@color/colorPrimary" />

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/divider" />

            <ImageButton
                android:id="@+id/cur_position"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cur_position"
                android:src="@drawable/ic_home_position"
                app:tint="@color/colorPrimary" />

            <ImageButton
                android:id="@+id/zoom_in"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/zoom_in"
                android:src="@drawable/ic_zoom_in"
                app:tint="@color/colorPrimary" />

            <ImageButton
                android:id="@+id/zoom_out"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/zoom_out"
                android:src="@drawable/ic_zoom_out"
                app:tint="@color/colorPrimary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#B3FFFFFF"
            android:gravity="center_horizontal|center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/app_statement"
            android:textColor="#5C7683"
            android:textSize="10sp"
            tools:ignore="SmallSp" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
